{
    "name": "normann/silverstripe-favicon-manager",
    "description": "Manage favicon and web app manifest files on SiteConfig from a single uploaded generator ZIP.",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": [
        "silverstripe",
        "favicon",
        "webmanifest",
        "pwa",
        "siteconfig"
    ],
    "authors": [
        {
            "name": "Weijun (Normann) Lou",
            "email": "normannlou@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-zip": "*",
        "ext-fileinfo": "*",
        "silverstripe/framework": "^5.0",
        "silverstripe/assets": "^2.0",
        "silverstripe/asset-admin": "^2.0",
        "silverstripe/versioned": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "suggest": {
        "silverstripe/subsites": "Automatically namespaces favicon storage per-subsite when installed"
    },
    "autoload": {
        "psr-4": {
            "Normann\\FaviconManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Normann\\FaviconManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
