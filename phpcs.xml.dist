<?xml version="1.0"?>
<ruleset name="FaviconManager">
    <description>Coding standard for silverstripe-favicon-manager</description>

    <file>src</file>
    <file>tests</file>

    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

    <!-- This stub deliberately has no namespace: it must declare a bare global
         Page class so silverstripe/errorpage's `use Page;` import resolves
         when testing this module in isolation (no real site "app" folder). -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>tests/Stub/Page.php</exclude-pattern>
    </rule>
</ruleset>
